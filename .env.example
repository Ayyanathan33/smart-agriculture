# Google Gemini API Key (Get a free API key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI ChatGPT API Key (Get an API key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI Engine Strategy: 'auto' (smart failover), 'gemini', or 'chatgpt'
AI_ENGINE=auto

# Live Internet Plant Pathology Research (Wikipedia API + ICAR databases)
INTERNET_RESEARCH=true

PORT=3000
